<style>
  .search-btn {
    background-color: #fe424d;
    color: #ffffff;
    border-radius: 25px;
    padding: 0 1rem;
    white-space: nowrap;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #ffffff;
  }

  .search-btn i {
    display: inline;
    margin: 0.5rem;
  }

  .search-input {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    min-width: 180px;
  }

  .search-form {
    display: flex;
    align-items: center;
  }

  /* Toggle Button */
  .navbar-toggler {
    background-color: #ffffff;
    border: 1px solid #ddd;
  }

  /* Tablet */
  @media (max-width: 991px) {

    .search-input {
      min-width: 140px;
      padding: 0.45rem 0.8rem;
    }

    .search-btn {
      padding: 0 0.7rem;
    }

    .search-btn i {
      margin: 0.3rem;
    }

    .navbar-nav .nav-link {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }


  /* Mobile */
  @media (max-width: 767px) {

    /* Toggle ke baad open hone wala menu */
    .navbar-collapse {
      background-color: #ffffff !important;
      padding: 1rem;
      margin-top: 0.5rem;
      border-radius: 8px;
      border: 1px solid #eeeeee;
    }

    .navbar-nav {
      width: 100%;
    }

    /* Search */
    .search-nav {
      margin: 0.5rem 0;
    }

    .search-form {
      width: 100%;
    }

    .search-input {
      width: 100%;
      min-width: 0;
    }

    .search-btn {
      padding: 0 1rem;
    }

    /* Right side links */
    .nav-right {
      margin-top: 0.5rem;
    }

    .nav-right .nav-link {
      padding: 0.5rem 0;
    }
  }


  /* Very Small Mobile */
  @media (max-width: 400px) {

    .search-btn {
      font-size: 0;
      padding: 0.5rem 0.8rem;
    }

    .search-btn i {
      font-size: 1rem;
      margin: 0;
    }

    .search-input {
      font-size: 0.9rem;
    }
  }


  /* Toggle open hone par button white */
  .navbar-toggler[aria-expanded="true"] {
    background-color: #ffffff !important;
  }
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <div class="container-fluid">

    <!-- Logo -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>
      <!-- Search -->
      <div class="navbar-nav ms-auto search-nav">
        <form class="d-flex search-form" role="search">
          <input
            class="form-control me-2 search-input"
            type="search"
            placeholder="Search - destinations" />

          <button class="btn search-btn"
            type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>

    <!-- Toggle Button -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar Content -->
    <div
      class="collapse navbar-collapse"
      id="navbarNavAltMarkup">

      <!-- Explore -->
      <div class="navbar-nav">

        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>

      <!-- Right Side Links -->
      <div class="navbar-nav ms-auto nav-right">

        <!-- Airbnb your home -->
        <a class="nav-link"
          href="/listings/new">
          Airbnb your home
        </a>

        <!-- When user is NOT logged in -->
        <% if(!currUser) { %>

          <a class="nav-link"
            href="/signup"><b>Sign Up</b></a>
          
          <a class="nav-link"
            href="/login"> <b>Log in</b>
          </a> <% } %>
        <!-- When user IS logged in -->
        <% if(currUser) { %>

          <a class="nav-link"
            href="/logout">
            <b>Log out</b>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>